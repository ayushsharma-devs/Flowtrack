# FlowTrack Environment Variables
SECRET_KEY=flowtrack-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Set USE_POSTGRES=True to connect to PostgreSQL, otherwise SQLite is used as zero-config default
USE_POSTGRES=False
DB_NAME=flowtrack_db
DB_USER=flowtrack_user
DB_PASSWORD=flowtrack_password
DB_HOST=localhost
DB_PORT=5432

# Frontend URL
FRONTEND_URL=http://localhost:3000
