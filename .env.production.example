# =============================================================================
# FlowTrack — Production Environment Variables
# Copy this file to .env.production and fill in real values before deploying.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Set to False if running behind a load balancer that terminates TLS
# and forwards plain HTTP to the container.
SECURE_SSL_REDIRECT=True

# ---------------------------------------------------------------------------
# Database — RDS PostgreSQL (via DATABASE_URL)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://flowtrack_user:STRONG_PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/flowtrack_db

# ---------------------------------------------------------------------------
# AWS Credentials (used by django-ses and boto3)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key

# ---------------------------------------------------------------------------
# Amazon SES Email
# ---------------------------------------------------------------------------
AWS_SES_REGION_NAME=us-east-1
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# Frontend (build-time arg — baked into the Next.js bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://yourdomain.com

# ---------------------------------------------------------------------------
# Nginx (optional override)
# ---------------------------------------------------------------------------
# NGINX_PORT=80
