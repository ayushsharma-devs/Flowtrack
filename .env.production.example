# =============================================================================
# FlowTrack — Production Environment Variables
# Copy this file to .env.production on your server and customize.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# Replace YOUR_EC2_PUBLIC_IP with your actual EC2 public IPv4 address
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-very-long-random-string-1234567890
DEBUG=False
ALLOWED_HOSTS=YOUR_EC2_PUBLIC_IP,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_PUBLIC_IP
SECURE_SSL_REDIRECT=False

# ---------------------------------------------------------------------------
# Database
# Default: Built-in containerized PostgreSQL (recommended for beginners)
# If using AWS RDS, replace with your RDS connection string
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://flowtrack_user:flowtrack_password@db:5432/flowtrack_db

# ---------------------------------------------------------------------------
# Email Backend
# Option 1 (Starter/Testing): Prints invite links to Docker logs & UI copy link
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FlowTrack <noreply@flowtrack.app>

# Option 2 (Amazon SES - for real email sending via AWS):
# Once you verify your email in Amazon SES (Step 9), switch to:
# EMAIL_BACKEND=django_ses.SESBackend
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SES_REGION_NAME=ap-south-1

# ---------------------------------------------------------------------------
# Frontend URL (Must match your EC2 Public IP or custom domain)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP
